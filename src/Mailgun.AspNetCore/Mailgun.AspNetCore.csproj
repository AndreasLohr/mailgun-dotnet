<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Mailgun.AspNetCore</RootNamespace>
    <AssemblyName>Mailgun.AspNetCore</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>mailgun-dotnet.AspNetCore</PackageId>
    <Description>ASP.NET Core endpoint helper for receiving Mailgun webhooks with HMAC verification and typed event dispatch.</Description>
    <Authors>Andreas Lohr</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 Andreas Lohr. All rights reserved.</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mailgun;sdk;email;webhooks;aspnetcore</PackageTags>
    <Version>0.9.4</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AndreasLohr/mailgun-dotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailgun.Webhooks\Mailgun.Webhooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
