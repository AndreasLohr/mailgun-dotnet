<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Mailgun.Webhooks</RootNamespace>
    <AssemblyName>Mailgun.Webhooks</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>mailgun-dotnet.Webhooks</PackageId>
    <Description>Typed webhook event parsing and HMAC-SHA256 signature verification for the mailgun-dotnet SDK. Framework-agnostic — usable from console apps, Azure Functions, AWS Lambdas.</Description>
    <Authors>Andreas Lohr</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 Andreas Lohr. All rights reserved.</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mailgun;sdk;email;webhooks;hmac</PackageTags>
    <Version>0.6.6</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AndreasLohr/mailgun-dotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailgun.Tests" />
    <InternalsVisibleTo Include="Mailgun.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
