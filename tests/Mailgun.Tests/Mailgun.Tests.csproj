<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target to match the SDK's TFMs so a net8.0-only regression (an API present in
         net10 but missing in net8) doesn't slip through a single-target test pass. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Suppressions for test-only code conventions that .NET 8 SDK analyzers flag as build-breaking.
         CA1707: test methods follow the standard xUnit `Snake_Case_Style` naming for readability of
           the failure output; renaming would harm test discoverability with no production benefit.
         CA1861: literal `new[] { ... }` arguments in test arrange-blocks are clearer than a sea of
           private static readonly fields; the perf-on-hot-path concern doesn't apply to tests.
         CA1305: locale-aware IFormatProvider on ToString — tests run in CI with invariant culture
           and the values formatted are simple integers / unix timestamps where locale doesn't bite.
         CA1859: concrete-return-type optimization in test helper builders is irrelevant — tests
           don't care about devirtualization.
         CS1998: a handful of test methods are declared `async Task` purely to match a shared helper
           signature; they intentionally have no `await`. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1305;CA1859;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Used by the RouteTemplate literal-only static check (Telemetry/RouteTemplateLiteralTests.cs).
         The check walks the service source files with Roslyn to assert every `routeTemplate:` argument
         is a string literal and never an interpolated string — the kind of cardinality bug that
         dynamic tests can't reliably catch because they typically run with a single fake domain. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mailgun\Mailgun.csproj" />
    <ProjectReference Include="..\..\src\Mailgun.Extensions.DependencyInjection\Mailgun.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Mailgun.Webhooks\Mailgun.Webhooks.csproj" />
    <ProjectReference Include="..\..\src\Mailgun.AspNetCore\Mailgun.AspNetCore.csproj" />
  </ItemGroup>

</Project>
