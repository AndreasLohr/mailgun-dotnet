{
  "stryker-config": {
    "project": "src/Mailgun/Mailgun.csproj",
    "test-projects": [
      "tests/Mailgun.Tests/Mailgun.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "reporters": [
      "progress",
      "html",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "!**/Models/**/*.cs",
      "!**/Internal/MailgunErrorResponse.cs",
      "!**/Pagination/PagingLinks.cs"
    ],
    "concurrency": 4,
    "verbosity": "info"
  }
}
